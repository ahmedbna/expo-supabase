# ─────────────────────────────────────────────────────────────────
# .env.example
#
# You usually don't fill this in by hand. Run `npm run init` and it
# will populate `.env.local` for you.
#
# These two are read by the *app* at runtime:
# ─────────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# ─────────────────────────────────────────────────────────────────
# These are read by the *CLI scripts* (npm run dev / npm run db:types)
# so they know which hosted project to push to. Auto-populated by
# `npm run init` — never commit them.
# ─────────────────────────────────────────────────────────────────

SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=


# Server-side only — used by scripts/ (NEVER expose with EXPO_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# OAuth providers (optional — fill in for production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
